# Copy to .env for local overrides. Production values live in Vercel → Project → Settings → Environment Variables.

# development | test | production
APP_ENV=development
# Local: SQLite. Production: Supabase transaction pooler with the least-privilege app_backend role, e.g.
# postgresql://app_backend.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./data/findmy.sqlite3

# Login. "local" prints codes to the console (dev/tests); "supabase" sends real codes via Supabase Auth.
AUTH_BACKEND=local
DEV_SHOW_CODE=true
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Who may sign in (comma-separated). Production is closed until one of these is set.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=
# Front desk staff and club officers (comma-separated emails) — they get the admin pages.
ADMIN_EMAILS=
# Only used to sign local-auth sessions.
SESSION_SECRET=dev-only-session-secret-change-me

# Photos. "local" writes to LOCAL_STORAGE_DIR; "blob" uses Vercel Blob (token added by Vercel).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads
BLOB_READ_WRITE_TOKEN=

# Daily expiry job (Vercel Cron sends "Authorization: Bearer $CRON_SECRET").
CRON_SECRET=
ITEM_TTL_DAYS=60

# Matching engine: auto (ONNX model if present, else TF-IDF) | onnx | tfidf
MATCHER_TEXT_BACKEND=auto
MATCHER_THREADS=2
