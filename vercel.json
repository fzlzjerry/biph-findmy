{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "functions": {
    "backend/app/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{docs/**,data/**,supabase/**,scripts/**,.github/**,backend/tests/**,matcher/tests/**,matcher/eval/**,frontend/src/**,frontend/tests/**,frontend/scripts/**,frontend/test-results/**,frontend/playwright-report/**}"
    }
  },
  "rewrites": [
    { "source": "/((?!api/|media/|assets/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/expire", "schedule": "0 19 * * *" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
